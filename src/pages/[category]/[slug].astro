---
import { getEntries, render } from 'astro:content';
import AdSlot from '@/components/AdSlot.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import ProductCard from '@/components/ProductCard.astro';
import TelegramCta from '@/components/TelegramCta.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getBuildableArticles, getListedArticles } from '@/lib/content';
import { formatAges } from '@/lib/format';
import { getBreadcrumbJsonLd, PUBLISHER } from '@/lib/seo';
import { CATEGORIES, SITE } from '@/site.config';

export async function getStaticPaths() {
    const articles = await getBuildableArticles();

    return articles.map((article) => ({
        params: { category: article.data.category, slug: article.id },
        props: { article },
    }));
}

const { article } = Astro.props;
const { title, description, category, publishedAt, updatedAt } = article.data;
const { Content, headings } = await render(article);
const toc = headings.filter((heading) => heading.depth === 2);
const products = (await getEntries(article.data.products)).filter((product) => !product.data.isDraft);
const related = (await getListedArticles())
    .filter((item) => item.data.category === category && item.id !== article.id)
    .slice(0, 3);
const dateFormatter = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
const categoryPath = `/${category}/`;
const image = `/pins/${article.id}/1.png`;
const jsonLd = [
    {
        '@type': 'Article',
        headline: title,
        description,
        image: new URL(image, SITE.url).href,
        datePublished: publishedAt.toISOString(),
        dateModified: (updatedAt ?? publishedAt).toISOString(),
        inLanguage: 'ru',
        mainEntityOfPage: new URL(`${categoryPath}${article.id}/`, SITE.url).href,
        author: PUBLISHER,
        publisher: PUBLISHER,
    },
    getBreadcrumbJsonLd([
        { name: CATEGORIES[category].title, path: categoryPath },
        { name: title, path: `${categoryPath}${article.id}/` },
    ]),
];
---

<BaseLayout title={title} description={description} ogType="article" publishedAt={publishedAt} image={image} jsonLd={jsonLd}>
    <article class="stack content">
        <header class="stack article-header">
            <Breadcrumbs items={[{ name: CATEGORIES[category].title, href: categoryPath }]} />
            <h1>{title}</h1>
            <p class="muted">
                {dateFormatter.format(updatedAt ?? publishedAt)}
            </p>
        </header>

        {
            products[0] && (
                <a class="quest-banner" href={`${SITE.telegramBotUrl}?start=${products[0].id}`} target="_blank" rel="noopener">
                    <span>
                        <strong>Готовый квест «{products[0].data.title}» для печати</strong>
                        <span class="muted"> — бесплатно в Telegram, {formatAges(products[0].data.ages)}</span>
                    </span>
                    <span class="quest-banner__action">Забрать →</span>
                </a>
            )
        }

        {
            toc.length >= 4 && (
                <details class="toc">
                    <summary>Содержание</summary>
                    <ol>
                        {toc.map((heading) => (
                            <li>
                                <a href={`#${heading.slug}`}>{heading.text}</a>
                            </li>
                        ))}
                    </ol>
                </details>
            )
        }

        <AdSlot slot="top" />

        <div class="prose">
            <Content />
        </div>

        {
            products.length > 0 && (
                <section class="stack">
                    <h2>Готовые квесты для печати</h2>
                    <div class="grid">
                        {products.map((product) => (
                            <ProductCard product={product} />
                        ))}
                    </div>
                </section>
            )
        }

        <TelegramCta quest={products[0]?.id} />

        <AdSlot slot="bottom" />

        {
            related.length > 0 && (
                <section class="stack">
                    <h2>Ещё идеи</h2>
                    <div class="grid">
                        {related.map((item) => (
                            <ArticleCard article={item} />
                        ))}
                    </div>
                </section>
            )
        }
    </article>
</BaseLayout>

<style>
    .article-header {
        gap: 8px;
    }

    .article-header h1 {
        margin: 0;
        font-size: 2.2rem;
    }

    .article-header p {
        margin: 0;
    }

    @media (max-width: 640px) {
        .article-header h1 {
            font-size: 1.8rem;
        }
    }

    .quest-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 18px;
        border-radius: var(--radius);
        background: #e8f6fd;
        border: 1px solid #bfe6f8;
        color: inherit;
        text-decoration: none;
        line-height: 1.4;
    }

    .quest-banner__action {
        flex-shrink: 0;
        padding: 8px 16px;
        border-radius: 999px;
        background: var(--color-telegram);
        color: #fff;
        font-weight: 600;
        white-space: nowrap;
    }

    .toc {
        padding: 12px 18px;
        border-radius: var(--radius);
        background: var(--color-surface);
        border: 1px solid var(--color-border);
    }

    .toc summary {
        cursor: pointer;
        font-weight: 600;
    }

    .toc ol {
        margin: 12px 0 4px;
        padding-left: 20px;
        line-height: 1.7;
    }

</style>
