---
import { render } from 'astro:content';
import ProductCover from '@/components/ProductCover.astro';
import TelegramCta from '@/components/TelegramCta.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getListedProducts, isProductFree } from '@/lib/content';
import { formatAges } from '@/lib/format';
import { SITE } from '@/site.config';

export async function getStaticPaths() {
    const products = await getListedProducts();

    return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}

const { product } = Astro.props;
const { title, description, theme, ages, price, buyUrl, telegramUrl, pages, coverColor, previews } = product.data;
const isFree = isProductFree(product);
const { Content } = await render(product);
---

<BaseLayout title={title} description={description}>
    <div class="product">
        <ProductCover title={title} theme={theme} ages={ages} color={coverColor} />
        <div class="stack">
            <h1>{title}</h1>
            <p class="muted">{description}</p>
            <ul class="product__facts">
                <li>Возраст: {formatAges(ages)}</li>
                {pages && <li>{pages} страниц A4, PDF</li>}
                <li>Печать на обычном принтере</li>
            </ul>
            {
                isFree ? (
                    <a class="button" href={telegramUrl ?? SITE.telegramUrl} target="_blank" rel="noopener">
                        Получить бесплатно в Telegram
                    </a>
                ) : buyUrl ? (
                    <a class="button" href={buyUrl} rel="nofollow">
                        Купить за {price} ₽
                    </a>
                ) : (
                    <span class="button button--disabled">{price} ₽ · скоро в продаже</span>
                )
            }
            <div class="prose"><Content /></div>
            {
                previews.length > 0 && (
                    <div class="product__previews">
                        {previews.map((src, i) => (
                            <img src={src} alt={`${title} — страница ${i + 1}`} width="794" height="1123" loading="lazy" />
                        ))}
                    </div>
                )
            }
        </div>
    </div>
    <div class="product__cta"><TelegramCta /></div>
</BaseLayout>

<style>
    .product {
        display: grid;
        grid-template-columns: minmax(220px, 320px) 1fr;
        gap: 40px;
        align-items: start;
    }

    .product h1 {
        margin: 0;
    }

    .product__facts {
        margin: 0;
        padding-left: 20px;
    }

    .product__previews {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 16px;
    }

    .product__previews img {
        border: 1px solid var(--color-border);
        border-radius: var(--radius-small);
    }

    .product__cta {
        max-width: var(--content-width);
        padding-top: 48px;
    }

    @media (max-width: 720px) {
        .product {
            grid-template-columns: 1fr;
        }
    }
</style>
